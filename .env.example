# Copy to .env and fill in. Never commit .env.

# Read NVIDIA's Isaac Sim licence, then set this to Y yourself. Required to build or run Isaac.
ACCEPT_EULA=
# Y or N: NVIDIA usage data collection
PRIVACY_CONSENT=N

# Where Isaac caches, logs and smoke reports live on the host
ISAAC_HOME=~/docker/isaac-sim

ROS_DOMAIN_ID=42

# Gemini vision. Run this to see the models your key can use today:
#   docker compose run --rm ros python3 scripts/list_gemini_models.py
GOOGLE_API_KEY=
GEMINI_MODEL=

# Optional telemetry
MONGODB_URI=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_SECRET_TOKEN=
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
ARIZE_API_KEY=
ARIZE_SPACE_ID=
